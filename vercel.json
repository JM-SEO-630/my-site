{
  "redirects": [
    { "source": "/index.html", "destination": "/", "statusCode": 301 },
    { "source": "/profile", "destination": "/NOSEA-Company-Profile-EN.pdf", "permanent": false },
    { "source": "/profile-es", "destination": "/NOSEA-Company-Profile-ES.pdf", "permanent": false }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
